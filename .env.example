# Telegram bot token from @BotFather. Keep this secret.
BOT_TOKEN=123456:replace_this_with_your_real_bot_token

# Public HTTPS URL where this app is deployed, with no trailing slash.
APP_URL=https://your-app.example.com
PORT=3000

# Supabase Project Settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_service_role_key

# Telegram numeric user IDs allowed to publish/manage. Comma-separated.
# Example: REP_TELEGRAM_IDS=123456789,987654321
REP_TELEGRAM_IDS=

# Optional allowlist for reading the hub. Empty means any Telegram user who
# opens the bot can read. If set, only listed IDs and representatives can read.
# Example: ALLOWED_TELEGRAM_IDS=123456789,987654321
ALLOWED_TELEGRAM_IDS=

# Optional Telegram group chat ID for new-post notifications.
# Add the bot to the group first. Usually a supergroup ID starts with -100.
TELEGRAM_GROUP_CHAT_ID=

# Max upload size in MB (default 25)
MAX_UPLOAD_MB=25
